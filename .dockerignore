# An allowlist of file types: Go sources and modules, and the web UI's
# sources. Nothing else, such as a local .env, reaches the build context,
# and a docs-only change keeps the build cached.
*
!go.mod
!go.sum
!**/*.go
**/*_test.go
# Some npm packages ship Go sources.
web/node_modules/**
# go:embed needs dist to exist, built or not.
!internal/web/dist/.gitkeep
# The web UI: what npm ci and npm run build read, never node_modules or a
# local .env.
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
web/src/**/*.test.ts
web/src/**/*.test.tsx
