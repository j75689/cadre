{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "publicURL": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "externalURL": {
          "type": "string",
          "pattern": "^(https?://[^/]+/?)?$"
        },
        "runnerAuth": {
          "enum": [
            "required",
            "none"
          ]
        },
        "timings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lease": {
              "type": "string"
            },
            "heartbeat": {
              "type": "string"
            },
            "stepIdle": {
              "type": "string"
            },
            "reclaimInterval": {
              "type": "string"
            },
            "dispatchInterval": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "oidc",
            "none"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "cliClientId": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "usernameClaim": {
              "type": "string",
              "minLength": 1
            },
            "groupsClaim": {
              "type": "string",
              "minLength": 1
            },
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "admins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "users": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^,\\s]+$"
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^,]+$"
              }
            }
          }
        },
        "sessionKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "pathStyle": {
              "type": "boolean"
            },
            "credentialsSecret": {
              "type": "string"
            },
            "accessKeyKey": {
              "type": "string",
              "minLength": 1
            },
            "secretKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterWide": {
          "type": "boolean"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "step",
            "runtime"
          ]
        },
        "parallel": {
          "type": "integer",
          "minimum": 1
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 0
        },
        "stepTimeout": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    }
  }
}
